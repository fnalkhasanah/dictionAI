{
  "name": "dictionai",
  "version": "1.0.0",
  "description": "The dictionary of free AI APIs — scrape, validate, and catalog AI API endpoints",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run build:web",
    "build:web": "vite build frontend",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "scrape": "ts-node src/index.ts scrape",
    "validate": "ts-node src/index.ts validate",
    "export": "ts-node src/index.ts export",
    "list": "ts-node src/index.ts list",
    "web": "ts-node src/web/server.ts",
    "tester": "node tools/model-tester/server.js"
  },
  "keywords": [
    "ai",
    "api",
    "scraper",
    "free-api"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "openai": "^4.50.0"
  },
  "devDependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/commander": "^2.12.2",
    "@types/express": "^4.17.21",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "allowScripts": {
    "better-sqlite3@9.6.0": true
  }
}
