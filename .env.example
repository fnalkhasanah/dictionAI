# AI API Scraper Configuration
# Copy this file to .env and fill in the values

# Database
DATABASE_PATH=./data/ai_apis.db

# Scraper settings
SCRAPE_DELAY_MS=1000
MAX_CONCURRENT=5
REQUEST_TIMEOUT_MS=10000

# Web UI
WEB_PORT=3000
WEB_HOST=localhost

# GitHub (optional - for higher rate limits)
GITHUB_TOKEN=

# Export settings
EXPORT_DIR=./data/exports
