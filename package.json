{
  "name": "dictionai",
  "version": "1.0.0",
  "description": "The dictionary of free AI APIs — scrape, validate, and catalog AI API endpoints",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-static.js",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "scrape": "ts-node src/index.ts scrape",
    "validate": "ts-node src/index.ts validate",
    "export": "ts-node src/index.ts export",
    "list": "ts-node src/index.ts list",
    "web": "ts-node src/web/server.ts"
  },
  "keywords": [
    "ai",
    "api",
    "scraper",
    "free-api"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/commander": "^2.12.2",
    "@types/ejs": "^3.1.4",
    "@types/express": "^4.17.21",
    "@types/node": "^26.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  },
  "allowScripts": {
    "better-sqlite3@9.6.0": true
  }
}
